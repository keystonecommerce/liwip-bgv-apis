generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Application {
  apiKeyId              String?
  id                    String                @id
  tenantId              String
  clientId              String
  packageId             String?
  status                String
  data                  Json
  legacyTestOptions     Json?                 @map("testOptions")
  /// Set for cases a worker opens themselves after OTP (91XXXXXXXXXX).
  workerPhone           String?
  /// Liwip BGV Card number, assigned when the case opens and kept when the card is issued.
  cardNumber            String?               @unique
  /// The worker's relationship with this partner. ENDED: the partner keeps the case
  /// as it was at relationshipEndedAt (relationshipSnapshot) and sees no later updates.
  relationshipStatus    String                @default("ACTIVE")
  relationshipEndedAt   DateTime?
  relationshipEndReason String?
  /// Case status when the relationship ended; partner filters use it for ENDED cases.
  relationshipEndStatus String?
  relationshipSnapshot  Json?
  relationshipEndedById String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  package               VerificationPackage?  @relation(fields: [packageId], references: [id])
  tenant                Tenant                @relation(fields: [tenantId], references: [id])
  client                Client                @relation(fields: [clientId, tenantId], references: [id, tenantId], map: "Application_client_owner_fkey")
  verifications         Verification[]
  documents             ApplicationDocument[]
  verificationCard      VerificationCard?
  fieldTasks            FieldTask[]
  providerCalls         ProviderCall[]
  aadhaarPhoto          AadhaarPhoto?
  workerPhoto           WorkerPhoto?
  initiatingKey         ApiKey?               @relation(fields: [apiKeyId, clientId], references: [id, clientId], onDelete: NoAction, map: "Application_key_owner_fkey")

  @@unique([id, tenantId, clientId])
  @@index([tenantId, createdAt])
  @@index([clientId, createdAt])
  @@index([clientId, workerPhone])
  @@index([packageId])
  @@index([status])
  @@index([createdAt])
  @@index([tenantId, relationshipStatus])
}

model VerificationCard {
  id             String              @id
  applicationId  String              @unique
  tenantId       String
  clientId       String
  cardNumber     String              @unique
  publicId       String              @unique
  status         String              @default("ACTIVE")
  issuedAt       DateTime            @default(now())
  expiresAt      DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  application    Application         @relation(fields: [applicationId, tenantId, clientId], references: [id, tenantId, clientId], onDelete: Cascade, map: "VerificationCard_application_owner_fkey")
  scans          CardScan[]
  verifierGrants VerifierCardGrant[]

  @@unique([applicationId, tenantId, clientId])
  @@unique([id, tenantId, clientId])
  @@index([tenantId, clientId, issuedAt])
  @@index([status, expiresAt])
}

/// A partner (e.g. Zomato), or the Liwip Direct tenant for individuals (kind DIRECT).
model Tenant {
  id                  String                @id
  slug                String                @unique
  name                String
  status              String                @default("ACTIVE")
  /// PARTNER | DIRECT
  kind                String                @default("PARTNER")
  legalName           String?
  gstin               String?
  /// { line1, line2?, city, state, pincode, country }
  address             Json?
  /// [{ name, email?, phone?, role? }]
  contacts            Json?
  logoUrl             String?
  disabledAt          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  clients             Client[]
  applications        Application[]
  aadhaarOvseSessions AadhaarOvseSession[]
  documents           ApplicationDocument[]
  portalUsers         PortalUser[]
  staffBindings       StaffRoleBinding[]
  discountRules       DiscountRule[]
  partnerPrices       PartnerPrice[]
  orders              Order[]
  seatLedger          SeatLedger[]
  bundleRequests      BundleRequest[]
  bulkUploads         BulkUpload[]
  invites             Invite[]
  checkRates          CheckRate[]
  prepaidCases        PrepaidCase[]
  usageCharges        UsageCharge[]
  usageStatements     UsageStatement[]

  @@index([status])
}

/// A partner's program (e.g. Zomato Delivery). Workers join it with its corporate code.
model Client {
  id                  String                @id
  tenantId            String
  code                String
  name                String
  status              String                @default("ACTIVE")
  /// What a worker types to join this program. Unique across all programs.
  corporateCode       String?               @unique
  description         String?
  disabledAt          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  apiKeys             ApiKey[]
  applications        Application[]
  aadhaarOvseSessions AadhaarOvseSession[]
  documents           ApplicationDocument[]
  portalUsers         PortalUser[]
  providerCalls       ProviderCall[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
  @@index([tenantId, status])
}

/// A staff account (Keystone staff, partner staff, vendors, field agents, verifiers).
/// Access comes only from StaffRoleBinding rows. `role` and `passwordHash` belong to the
/// deprecated password login of /v1/portal-auth (field app) and are never read by /v1/admin.
model PortalUser {
  id             String             @id
  /// Home partner, for partner staff. Scope still comes from bindings.
  tenantId       String?
  clientId       String?
  email          String             @unique
  displayName    String
  /// ACTIVE | DISABLED
  status         String             @default("ACTIVE")
  /// Bumped to revoke every session of this account.
  sessionVersion Int                @default(0)
  invitedById    String?
  lastLoginAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  tenant         Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client         Client?            @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Cascade, map: "PortalUser_client_owner_fkey")
  fieldTasks     FieldTask[]        @relation("AgentTasks")
  bindings       StaffRoleBinding[]
  sessions       StaffSession[]
  passkeys       StaffPasskey[]
  verifierAccess VerifierAccess?

  @@index([tenantId, status])
  @@index([clientId, status])
}

model ApiKey {
  id                    String         @id
  clientId              String
  name                  String
  keyPrefix             String
  keyHash               String         @unique
  scopes                Json
  isActive              Boolean        @default(true)
  expiresAt             DateTime?
  lastUsedAt            DateTime?
  revokedAt             DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  client                Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  providerCalls         ProviderCall[]
  initiatedApplications Application[]

  @@unique([id, clientId])
  @@index([clientId, isActive])
}

// Legacy terminal-outcome projection, retained for historical compatibility.
// Never used for new API billing: ProviderCall is authoritative.
model UsageEvent {
  id             String   @id
  tenantId       String
  clientId       String
  applicationId  String
  verificationId String   @unique
  checkType      String
  result         String // VERIFIED | NEGATIVE | MANUAL_REVIEW | ERROR
  billable       Boolean
  provider       String?
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([clientId, createdAt])
  @@index([billable, createdAt])
  @@index([checkType])
}

// Append-only trail of partner API activity and key lifecycle events, for
// security review, compliance and per-partner history. Written best-effort by
// AuditInterceptor (successful/handled calls) and ApiKeyGuard (rejected auth).
// Foreign keys are intentionally omitted so a log row survives tenant/client
// deletion and never blocks a request; ids are plain strings.
model AuditLog {
  id           String   @id
  actorType    String // PARTNER | ADMIN | SYSTEM | STAFF | VERIFIER | PUBLIC
  /// Staff account (PortalUser) behind an admin-panel action or lookup.
  actorUserId  String?
  tenantId     String?
  tenantSlug   String?
  clientId     String?
  clientCode   String?
  apiKeyId     String?
  keyPrefix    String?
  action       String // e.g. applications.create, apiKey.revoke, auth.rejected
  method       String?
  path         String?
  statusCode   Int?
  resourceType String?
  resourceId   String?
  scopeUsed    String?
  ip           String?
  userAgent    String?
  durationMs   Int?
  outcome      String // SUCCESS | CLIENT_ERROR | SERVER_ERROR | REJECTED
  message      String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceId, createdAt])
  @@index([clientId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([action, createdAt])
  @@index([outcome, createdAt])
}

model VerificationPackage {
  id                   String        @id
  code                 String
  version              Int
  name                 String
  description          String?
  kind                 String        @default("BASE")
  priceInr             Int?
  advertisedCheckCount Int?
  targetWorkforce      String?
  displayOrder         Int           @default(0)
  isActive             Boolean       @default(true)
  checks               Json
  /// RIDER, DRIVER, HOME_SERVICES_PRO, CUSTOMER_REP, ... (null for add-ons)
  role                 String?
  /// PEOPLE | VEHICLE
  module               String        @default("PEOPLE")
  /// DRAFT | PUBLISHED | RETIRED. Only one PUBLISHED version per code; isActive mirrors it.
  status               String        @default("PUBLISHED")
  /// Price per person in paise. priceInr is kept for older readers.
  listPricePaise       Int?
  /// A partner's own custom bundle (from a BundleRequest): only that partner sees and buys it. Null: on sale to everyone.
  tenantId             String?
  /// Most seats one order may buy of this bundle. Null: no limit beyond the order cap.
  maxSeatsPerOrder     Int?
  publishedAt          DateTime?
  createdById          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  applications         Application[]
  orderLines           OrderLine[]

  @@unique([code, version])
  @@index([code, status])
  @@index([code, isActive])
  @@index([tenantId])
}

model Verification {
  id                String         @id
  applicationId     String
  /// Copied from the application so scoped queries filter this table directly.
  tenantId          String
  clientId          String
  type              String
  status            String
  provider          String
  attemptCount      Int            @default(0)
  providerRequestId String?
  result            Json?
  failureResponse   Json?
  failureCode       String?
  failureReason     String?
  createdAt         DateTime       @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime       @updatedAt
  application       Application    @relation(fields: [applicationId, tenantId, clientId], references: [id, tenantId, clientId], onDelete: Cascade, map: "Verification_application_owner_fkey")
  fieldTask         FieldTask?
  providerCalls     ProviderCall[]

  @@unique([id, applicationId])
  @@index([applicationId])
  @@index([tenantId, clientId, type])
  @@index([status])
  @@index([type])
}

model AadhaarOvseSession {
  id                String    @id
  tenantId          String
  clientId          String
  providerClientId  String    @unique
  referenceId       String
  channel           String
  status            String    @default("pending")
  requestedClaims   Json
  statusDescription String?
  result            Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?
  resultRetrievedAt DateTime?
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client            Client    @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Cascade, map: "AadhaarOvseSession_client_owner_fkey")

  @@index([tenantId, createdAt])
  @@index([clientId, createdAt])
  @@index([status])
}

model ApplicationDocument {
  id                String      @id
  tenantId          String
  clientId          String
  applicationId     String
  documentType      String
  status            String      @default("PENDING_UPLOAD")
  bucket            String
  objectKey         String
  originalFileName  String
  contentType       String
  declaredSizeBytes Int
  sizeBytes         Int?
  versionId         String?
  etag              String?
  checksumSha256    String?
  storageEncryption String?
  kmsKeyArn         String?
  expiresAt         DateTime
  uploadedAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client            Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  application       Application @relation(fields: [applicationId, tenantId, clientId], references: [id, tenantId, clientId], onDelete: Cascade, map: "ApplicationDocument_application_owner_fkey")

  @@unique([bucket, objectKey])
  @@index([tenantId, clientId, createdAt])
  @@index([applicationId, createdAt])
  @@index([status, expiresAt])
}

// A physical field-verification task assigned to a FIELD_AGENT portal user.
// It fulfils one MANUAL verification check (e.g. physical address). See PRD section 14.
model FieldTask {
  id               String          @id
  tenantId         String
  clientId         String
  applicationId    String
  verificationId   String          @unique
  assignedToUserId String?
  /// The vendor Keystone handed this visit to. Only that vendor's agents see it; none until set.
  vendorId         String?
  taskType         String          @default("ADDRESS_VERIFICATION")
  status           String          @default("PENDING_ASSIGNMENT")
  workerName       String
  addressText      String
  instructions     String?
  dueAt            DateTime?
  outcome          String?
  notes            String?
  rejectionReason  String?
  arrivedAt        DateTime?
  arriveLatitude   Float?
  arriveLongitude  Float?
  acceptedAt       DateTime?
  submittedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  application      Application     @relation(fields: [applicationId, tenantId, clientId], references: [id, tenantId, clientId], onDelete: Cascade, map: "FieldTask_application_owner_fkey")
  verification     Verification    @relation(fields: [verificationId, applicationId], references: [id, applicationId], onDelete: Cascade, map: "FieldTask_verification_owner_fkey")
  assignedTo       PortalUser?     @relation("AgentTasks", fields: [assignedToUserId], references: [id])
  vendor           Vendor?         @relation(fields: [vendorId], references: [id])
  evidence         FieldEvidence[]

  @@unique([verificationId, applicationId])
  @@index([assignedToUserId, status])
  @@index([vendorId, status])
  @@index([tenantId, clientId, status])
  @@index([status, dueAt])
}

// Photo / signature evidence captured on a field visit, stored privately in S3.
model FieldEvidence {
  id                String    @id
  fieldTaskId       String
  tenantId          String
  clientId          String
  kind              String
  status            String    @default("PENDING_UPLOAD")
  bucket            String
  objectKey         String
  originalFileName  String
  contentType       String
  declaredSizeBytes Int
  sizeBytes         Int?
  capturedLatitude  Float?
  capturedLongitude Float?
  capturedAt        DateTime?
  uploadedAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  fieldTask         FieldTask @relation(fields: [fieldTaskId], references: [id], onDelete: Cascade)

  @@unique([bucket, objectKey])
  @@index([fieldTaskId, createdAt])
}

// Durable provider-call accounting, separate from verification/reviewer outcomes.
// STARTED is committed before dispatch. Ambiguous results require reconciliation.
model ProviderCall {
  id                String        @id
  tenantId          String
  clientId          String
  apiKeyId          String?
  applicationId     String?
  verificationId    String?
  operationKey      String        @unique
  provider          String
  operation         String
  state             String        @default("STARTED")
  httpStatus        Int?
  providerRequestId String?
  startedAt         DateTime      @default(now())
  completedAt       DateTime?
  client            Client        @relation(fields: [clientId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "ProviderCall_client_owner_fkey")
  application       Application?  @relation(fields: [applicationId, tenantId, clientId], references: [id, tenantId, clientId], onDelete: Restrict, map: "ProviderCall_application_owner_fkey")
  verification      Verification? @relation(fields: [verificationId, applicationId], references: [id, applicationId], onDelete: Restrict, map: "ProviderCall_verification_owner_fkey")
  apiKey            ApiKey?       @relation(fields: [apiKeyId, clientId], references: [id, clientId], onDelete: Restrict, map: "ProviderCall_key_owner_fkey")

  @@index([tenantId, clientId, startedAt])
  @@index([verificationId, state])
  @@index([state, startedAt])
}

/// A worker's passkey (WebAuthn credential) for signing in without OTP.
/// The private key never leaves the device; we keep only the public key.
model WorkerPasskey {
  id           String    @id
  tenantId     String
  clientId     String
  /// Normalised 91XXXXXXXXXX, the same phone the worker verified by OTP.
  workerPhone  String
  /// Base64URL credential ID from the authenticator.
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   Json?
  deviceType   String?
  backedUp     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([tenantId, clientId, workerPhone])
}

/// Photo from the worker's verified Aadhaar (DigiLocker), kept for face match.
/// Encrypted at rest by RDS/KMS; deleted with the case.
model AadhaarPhoto {
  applicationId String      @id
  tenantId      String
  clientId      String
  contentType   String
  bytes         Bytes
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId, tenantId, clientId], references: [id, tenantId, clientId], onDelete: Cascade, map: "AadhaarPhoto_application_owner_fkey")

  @@unique([applicationId, tenantId, clientId])
}

/// The worker's face-matched selfie, shown on their card and verify page.
/// Encrypted at rest by RDS/KMS; deleted with the case.
model WorkerPhoto {
  applicationId String      @id
  tenantId      String
  clientId      String
  contentType   String
  bytes         Bytes
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId, tenantId, clientId], references: [id, tenantId, clientId], onDelete: Cascade, map: "WorkerPhoto_application_owner_fkey")

  @@unique([applicationId, tenantId, clientId])
}

/// One row per check of a card: QR from the app, the fixed (shared or printed) link, or a typed number.
model CardScan {
  id             String           @id
  cardId         String
  /// The card owner's partner and program, copied for uniform scoping.
  tenantId       String
  clientId       String
  /// PRINT (fixed QR or link) | APP (live QR) | NUMBER (typed card number)
  via            String
  result         String
  ipHash         String
  /// PUBLIC | VERIFIER | PARTNER | KEYSTONE: who looked the card up.
  viewerType     String           @default("PUBLIC")
  /// Staff account that looked the card up (null for anonymous public scans).
  viewerUserId   String?
  /// Partner the viewer acted for, when partner staff.
  viewerTenantId String?
  /// PUBLIC | VERIFIER | FULL: what the viewer was shown.
  view           String           @default("PUBLIC")
  scannedAt      DateTime         @default(now())
  card           VerificationCard @relation(fields: [cardId, tenantId, clientId], references: [id, tenantId, clientId], onDelete: Cascade, map: "CardScan_card_owner_fkey")

  @@index([cardId, scannedAt])
  @@index([tenantId, scannedAt])
  @@index([viewerUserId, scannedAt])
}

/// A vendor running ground checks (field address and police verification).
model Vendor {
  id         String             @id
  slug       String             @unique
  name       String
  /// ACTIVE | DISABLED
  status     String             @default("ACTIVE")
  contacts   Json?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  bindings   StaffRoleBinding[]
  fieldTasks FieldTask[]

  @@index([status])
}

/// The only source of admin access: a system role granted at one scope.
/// GLOBAL (Keystone), PARTNER (one tenant) or VENDOR (one vendor). See ADMIN-ACCESS.md.
model StaffRoleBinding {
  id          String     @id
  userId      String
  roleKey     String
  /// GLOBAL | PARTNER | VENDOR
  scopeType   String
  /// "GLOBAL", "partner:<tenantId>" or "vendor:<vendorId>"; keeps bindings unique.
  scopeKey    String
  tenantId    String?
  vendorId    String?
  grantedById String?
  createdAt   DateTime   @default(now())
  user        PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor      Vendor?    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, roleKey, scopeKey])
  @@index([tenantId, roleKey])
  @@index([vendorId, roleKey])
  @@index([userId])
}

/// One emailed sign-in code. Only an HMAC of the code is stored.
model StaffOtp {
  id         String    @id
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ipHash     String?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

/// A signed-in admin panel session. The cookie holds a random token; only its hash is kept.
model StaffSession {
  id             String     @id
  userId         String
  tokenHash      String     @unique
  /// Must equal the account's sessionVersion; bumping that revokes the session.
  sessionVersion Int
  /// otp | passkey
  authMethod     String
  /// Last sign-in or "confirm it's you"; powerful actions need it within ADMIN_RECENT_SIGN_IN_MINUTES.
  verifiedAt     DateTime   @default(now())
  ipHash         String?
  userAgent      String?
  createdAt      DateTime   @default(now())
  lastSeenAt     DateTime   @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  user           PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// A staff account's WebAuthn passkey. Only the public key is kept.
model StaffPasskey {
  id           String     @id
  userId       String
  rpId         String
  credentialId String     @unique
  publicKey    Bytes
  counter      BigInt     @default(0)
  transports   Json?
  deviceType   String?
  backedUp     Boolean    @default(false)
  name         String     @default("Passkey")
  createdAt    DateTime   @default(now())
  lastUsedAt   DateTime?
  user         PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Single-use WebAuthn challenge for staff sign-in or passkey setup.
model StaffAuthChallenge {
  id        String   @id
  /// authenticate | register
  purpose   String
  userId    String?
  rpId      String
  origin    String
  challenge String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Card-lookup access Keystone grants to a verifier account. SCOPED: cards the verifier
/// scans plus a granted set; UNIVERSAL: any card. Lookups only by QR token or card number.
model VerifierAccess {
  id           String              @id
  userId       String              @unique
  /// SCOPED | UNIVERSAL
  level        String
  organisation String?
  purpose      String?
  expiresAt    DateTime?
  revokedAt    DateTime?
  revokedById  String?
  grantedById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         PortalUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards        VerifierCardGrant[]
}

/// A card a SCOPED verifier may look up by number: granted by Keystone or scanned by them.
model VerifierCardGrant {
  id               String           @id
  verifierAccessId String
  cardId           String
  /// GRANTED | SCANNED
  source           String
  grantedById      String?
  createdAt        DateTime         @default(now())
  access           VerifierAccess   @relation(fields: [verifierAccessId], references: [id], onDelete: Cascade)
  card             VerificationCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([verifierAccessId, cardId])
  @@index([cardId])
}

/// Add-ons offered with a base package (by code, so every version of both).
model PackageAddOn {
  id              String   @id
  basePackageCode String
  addOnCode       String
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([basePackageCode, addOnCode])
}

/// Bulk discount tier: a percentage off a line whose quantity falls in [minQty, maxQty].
model DiscountRule {
  id            String    @id
  /// GLOBAL | PARTNER
  scope         String
  tenantId      String?
  /// null = every package
  packageCode   String?
  minQty        Int
  maxQty        Int?
  /// 500 = 5%
  percentOffBps Int
  validFrom     DateTime?
  validTo       DateTime?
  isActive      Boolean   @default(true)
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([scope, isActive])
  @@index([tenantId, isActive])
}

/// A negotiated price for one partner. Replaces the list price before discount tiers.
model PartnerPrice {
  id             String    @id
  tenantId       String
  packageCode    String
  unitPricePaise Int
  validFrom      DateTime?
  validTo        DateTime?
  isActive       Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, packageCode, isActive])
}

/// A priced, read-only snapshot. Checkout always goes through one.
model Quote {
  id            String   @id
  /// PARTNER | INDIVIDUAL
  buyerType     String
  tenantId      String
  clientId      String?
  applicationId String?
  /// The priced lines and every input used (versions, rules, prices).
  lines         Json
  subtotalPaise Int
  discountPaise Int
  taxablePaise  Int
  cgstPaise     Int
  sgstPaise     Int
  igstPaise     Int
  totalPaise    Int
  expiresAt     DateTime
  createdById   String?
  createdAt     DateTime @default(now())
  order         Order?

  @@index([tenantId, createdAt])
}

/// id is the 10-character order code, also Cashfree's order_id.
model Order {
  id               String      @id
  quoteId          String      @unique
  buyerType        String
  tenantId         String
  clientId         String?
  applicationId    String?
  createdById      String?
  /// PENDING_PAYMENT | PAID | FAILED | EXPIRED | REFUNDED | PARTIALLY_REFUNDED
  status           String      @default("PENDING_PAYMENT")
  currency         String      @default("INR")
  subtotalPaise    Int
  discountPaise    Int
  taxablePaise     Int
  cgstPaise        Int
  sgstPaise        Int
  igstPaise        Int
  totalPaise       Int
  refundedPaise    Int         @default(0)
  idempotencyKey   String
  cfOrderId        String?
  paymentSessionId String?
  expiresAt        DateTime
  paidAt           DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  quote            Quote       @relation(fields: [quoteId], references: [id])
  lines            OrderLine[]
  payments         Payment[]
  refunds          Refund[]
  invoice          Invoice?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([status, expiresAt])
}

model OrderLine {
  id             String              @id
  orderId        String
  tenantId       String
  packageId      String
  packageCode    String
  packageVersion Int
  /// PACKAGE | EXTRAS (checks bought for a case under way, on that case's package)
  kind           String              @default("PACKAGE")
  quantity       Int
  unitListPaise  Int
  unitPricePaise Int
  /// [{ checkType, checkRateId, unitPricePaise }]
  addOns         Json
  discountRuleId String?
  discountBps    Int                 @default(0)
  discountPaise  Int                 @default(0)
  /// Package sale after discount, and add-on check sale: the two kinds of revenue.
  packagePaise   Int                 @default(0)
  addOnPaise     Int                 @default(0)
  lineTotalPaise Int
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  package        VerificationPackage @relation(fields: [packageId], references: [id])

  @@index([orderId])
  @@index([tenantId, packageCode])
}

model Payment {
  id          String   @id
  orderId     String
  tenantId    String
  /// CASHFREE
  provider    String
  cfPaymentId String?
  status      String
  amountPaise Int
  method      String?
  receivedAt  DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, cfPaymentId])
  @@index([orderId])
}

/// Every webhook received. Duplicates are dropped by (provider, idempotencyKey).
model PaymentWebhookEvent {
  id             String    @id
  provider       String
  idempotencyKey String
  type           String
  orderId        String?
  signatureValid Boolean
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@unique([provider, idempotencyKey])
  @@index([orderId])
}

model Refund {
  /// The order code plus R1, R2, ... (also Cashfree's refund_id).
  id          String   @id
  orderId     String
  tenantId    String
  amountPaise Int
  /// PENDING | SUCCESS | FAILED | CANCELLED
  status      String
  reason      String
  cfRefundId  String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Invoice {
  id           String          @id
  /// LBV/2026-27/00001
  number       String          @unique
  /// Exactly one of orderId (a Cashfree order) or statementId (a monthly usage statement).
  orderId      String?         @unique
  statementId  String?         @unique
  tenantId     String
  buyerName    String
  buyerGstin   String?
  buyerState   String?
  /// Keystone's registration as it stood when the invoice was issued.
  sellerName   String          @default("Keystone Commerce Private Limited")
  sellerGstin  String          @default("29AAMCK2232K1Z9")
  sellerState  String
  sacCode      String
  taxablePaise Int
  cgstPaise    Int
  sgstPaise    Int
  igstPaise    Int
  totalPaise   Int
  storageKey   String?
  issuedAt     DateTime        @default(now())
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  statement    UsageStatement? @relation(fields: [statementId], references: [id], onDelete: Restrict)

  @@index([tenantId, issuedAt])
}

model InvoiceCounter {
  /// e.g. 2026-27
  financialYear String @id
  next          Int    @default(1)
}

/// Append-only seat ledger. Available = sum(delta) of PURCHASE, RESERVE, RELEASE, CONSUME, ADJUST rows.
/// RESERVE is negative; CONSUME of a reserved seat is 0 (it only moves the seat); RELEASE is positive.
model SeatLedger {
  id             String   @id
  tenantId       String
  packageCode    String
  packageVersion Int
  delta          Int
  /// PURCHASE | RESERVE | RELEASE | CONSUME | ADJUST
  kind           String
  orderLineId    String?
  inviteId       String?
  reason         String?
  createdById    String?
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, packageCode])
  @@index([inviteId])
}

model BulkUpload {
  id            String    @id
  tenantId      String
  clientId      String
  packageCode   String
  fileName      String
  rowCount      Int
  readyCount    Int
  rejectedCount Int
  /// [{ row, name, phone, status, reason? }] after validation
  rows          Json
  /// VALIDATED | SENT
  status        String    @default("VALIDATED")
  createdById   String?
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  invites       Invite[]

  @@index([tenantId, createdAt])
}

/// A link sent to one person. It opens only for the uploaded phone.
model Invite {
  id             String      @id
  tenantId       String
  clientId       String
  uploadId       String?
  packageCode    String
  packageVersion Int
  name           String
  /// 91XXXXXXXXXX
  phone          String
  tokenHash      String      @unique
  /// SENT | STARTED | COMPLETED | EXPIRED | CANCELLED
  status         String      @default("SENT")
  expiresAt      DateTime
  /// WHATSAPP | SMS
  channel        String?
  messageId      String?
  deliveryStatus String?
  applicationId  String?
  createdById    String?
  startedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  upload         BulkUpload? @relation(fields: [uploadId], references: [id])

  @@index([tenantId, phone, status])
  @@index([status, expiresAt])
}

/// The price of one check run. tenantId null is the list price; a partner's row replaces it.
/// Used for add-on checks an individual buys and for partners' API usage.
model CheckRate {
  id             String    @id
  tenantId       String?
  checkType      String
  unitPricePaise Int
  validFrom      DateTime?
  validTo        DateTime?
  isActive       Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([checkType, isActive])
  @@index([tenantId, checkType])
}

/// The checks already paid for on a case: its package (an individual's order or a company seat)
/// and any add-ons. Checks listed here are never billed as API usage.
model PrepaidCase {
  applicationId  String   @id
  tenantId       String
  /// ORDER | SEAT
  source         String
  orderId        String?
  inviteId       String?
  packageCode    String
  packageVersion Int
  /// ["PAN", "DRIVING_LICENSE", ...]
  coveredChecks  Json
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

/// One billed check run through a partner's API. verificationId is unique: never billed twice.
model UsageCharge {
  id             String          @id
  verificationId String          @unique
  tenantId       String
  clientId       String
  applicationId  String
  checkType      String
  checkRateId    String
  unitPricePaise Int
  occurredAt     DateTime
  statementId    String?
  createdAt      DateTime        @default(now())
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  statement      UsageStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([statementId])
  @@index([occurredAt])
}

/// A partner's monthly API usage bill. Issuing it issues the invoice.
model UsageStatement {
  id               String        @id
  tenantId         String
  /// 2026-10
  period           String
  /// ISSUED | PAID | VOID
  status           String        @default("ISSUED")
  /// [{ checkType, count, unitPricePaise, amountPaise }]
  lines            Json
  checkCount       Int
  taxablePaise     Int
  cgstPaise        Int
  sgstPaise        Int
  igstPaise        Int
  totalPaise       Int
  issuedAt         DateTime      @default(now())
  dueAt            DateTime
  paidAt           DateTime?
  paymentReference String?
  createdById      String?
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  charges          UsageCharge[]
  invoice          Invoice?

  @@unique([tenantId, period])
  @@index([status, dueAt])
}

/// A partner's own bundle: they pick the checks and ask for a price; Keystone prices it;
/// accepting it puts a private package on sale to that partner only.
model BundleRequest {
  id               String    @id
  tenantId         String
  name             String
  /// [check type]; Aadhaar is always included.
  checks           Json
  expectedSeats    Int?
  note             String?
  /// REQUESTED | PRICED | ACCEPTED | DECLINED | WITHDRAWN
  status           String    @default("REQUESTED")
  requestedById    String
  /// Keystone's offer: price per seat, the seat limit per order, and until when it holds.
  unitPricePaise   Int?
  maxSeatsPerOrder Int?
  priceValidUntil  DateTime?
  replyNote        String?
  pricedById       String?
  pricedAt         DateTime?
  /// PARTNER (declined the price or withdrew) | KEYSTONE (won't offer it)
  closedBy         String?
  closedAt         DateTime?
  acceptedById     String?
  acceptedAt       DateTime?
  /// The private package made when the price was accepted.
  packageId        String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

/// What one check costs Keystone to run (provider fee or field cost), for pricing bundles. Keystone only; never shown to partners.
model CheckCost {
  checkType     String   @id
  unitCostPaise Int
  note          String?
  updatedById   String?
  updatedAt     DateTime @updatedAt
}

