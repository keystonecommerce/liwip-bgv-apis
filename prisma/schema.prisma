generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Application {
  id                String                @id
  tenantId          String
  clientId          String
  packageId         String?
  status            String
  data              Json
  legacyTestOptions Json?                 @map("testOptions")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  package           VerificationPackage?  @relation(fields: [packageId], references: [id])
  tenant            Tenant                @relation(fields: [tenantId], references: [id])
  client            Client                @relation(fields: [clientId], references: [id])
  verifications     Verification[]
  documents         ApplicationDocument[]
  verificationCard  VerificationCard?
  fieldTasks        FieldTask[]

  @@index([tenantId, createdAt])
  @@index([clientId, createdAt])
  @@index([packageId])
  @@index([status])
  @@index([createdAt])
}

model VerificationCard {
  id            String      @id
  applicationId String      @unique
  tenantId      String
  clientId      String
  cardNumber    String      @unique
  publicId      String      @unique
  status        String      @default("ACTIVE")
  issuedAt      DateTime    @default(now())
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId, issuedAt])
  @@index([status, expiresAt])
}

model Tenant {
  id                  String                @id
  slug                String                @unique
  name                String
  status              String                @default("ACTIVE")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  clients             Client[]
  applications        Application[]
  aadhaarOvseSessions AadhaarOvseSession[]
  documents           ApplicationDocument[]
  portalUsers         PortalUser[]

  @@index([status])
}

model Client {
  id                  String                @id
  tenantId            String
  code                String
  name                String
  status              String                @default("ACTIVE")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  apiKeys             ApiKey[]
  applications        Application[]
  aadhaarOvseSessions AadhaarOvseSession[]
  documents           ApplicationDocument[]
  portalUsers         PortalUser[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model PortalUser {
  id           String    @id
  tenantId     String?
  clientId     String?
  email        String    @unique
  displayName  String
  passwordHash String
  role         String
  status       String    @default("ACTIVE")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fieldTasks   FieldTask[] @relation("AgentTasks")

  @@index([tenantId, role, status])
  @@index([clientId, role, status])
  @@index([role, status])
}

model ApiKey {
  id         String    @id
  clientId   String
  name       String
  keyPrefix  String
  keyHash    String    @unique
  scopes     Json
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, isActive])
}

// Append-only billing/metering ledger: one row per verification that reached a
// terminal state. `billable` is true when the provider actually did the work
// (VERIFIED / NEGATIVE / MANUAL_REVIEW) and false for provider/system errors, so
// partner billing = count of billable rows. Written by the usage-metering
// BullMQ worker; unique on verificationId makes it idempotent under retries.
model UsageEvent {
  id             String   @id
  tenantId       String
  clientId       String
  applicationId  String
  verificationId String   @unique
  checkType      String
  result         String   // VERIFIED | NEGATIVE | MANUAL_REVIEW | ERROR
  billable       Boolean
  provider       String?
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([clientId, createdAt])
  @@index([billable, createdAt])
  @@index([checkType])
}

// Append-only trail of partner API activity and key lifecycle events, for
// security review, compliance and per-partner history. Written best-effort by
// AuditInterceptor (successful/handled calls) and ApiKeyGuard (rejected auth).
// Foreign keys are intentionally omitted so a log row survives tenant/client
// deletion and never blocks a request; ids are plain strings.
model AuditLog {
  id           String   @id
  actorType    String   // PARTNER | ADMIN | SYSTEM
  tenantId     String?
  tenantSlug   String?
  clientId     String?
  clientCode   String?
  apiKeyId     String?
  keyPrefix    String?
  action       String   // e.g. applications.create, apiKey.revoke, auth.rejected
  method       String?
  path         String?
  statusCode   Int?
  resourceType String?
  resourceId   String?
  scopeUsed    String?
  ip           String?
  userAgent    String?
  durationMs   Int?
  outcome      String   // SUCCESS | CLIENT_ERROR | SERVER_ERROR | REJECTED
  message      String?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([clientId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([action, createdAt])
  @@index([outcome, createdAt])
}

model VerificationPackage {
  id                   String        @id
  code                 String
  version              Int
  name                 String
  description          String?
  kind                 String        @default("BASE")
  priceInr             Int?
  advertisedCheckCount Int?
  targetWorkforce      String?
  displayOrder         Int           @default(0)
  isActive             Boolean       @default(true)
  checks               Json
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  applications         Application[]

  @@unique([code, version])
  @@index([code, isActive])
}

model Verification {
  id                String      @id
  applicationId     String
  type              String
  status            String
  provider          String
  attemptCount      Int         @default(0)
  providerRequestId String?
  result            Json?
  failureResponse   Json?
  failureCode       String?
  failureReason     String?
  createdAt         DateTime    @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime    @updatedAt
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fieldTask         FieldTask?

  @@index([applicationId])
  @@index([status])
  @@index([type])
}

model AadhaarOvseSession {
  id                String    @id
  tenantId          String
  clientId          String
  providerClientId  String    @unique
  referenceId       String
  channel           String
  status            String    @default("pending")
  requestedClaims   Json
  statusDescription String?
  result            Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?
  resultRetrievedAt DateTime?
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([clientId, createdAt])
  @@index([status])
}

model ApplicationDocument {
  id                String      @id
  tenantId          String
  clientId          String
  applicationId     String
  documentType      String
  status            String      @default("PENDING_UPLOAD")
  bucket            String
  objectKey         String
  originalFileName  String
  contentType       String
  declaredSizeBytes Int
  sizeBytes         Int?
  versionId         String?
  etag              String?
  checksumSha256    String?
  storageEncryption String?
  kmsKeyArn         String?
  expiresAt         DateTime
  uploadedAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client            Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([bucket, objectKey])
  @@index([tenantId, clientId, createdAt])
  @@index([applicationId, createdAt])
  @@index([status, expiresAt])
}

// A physical field-verification task assigned to a FIELD_AGENT portal user.
// It fulfils one MANUAL verification check (e.g. physical address). See PRD section 14.
model FieldTask {
  id               String          @id
  tenantId         String
  clientId         String
  applicationId    String
  verificationId   String          @unique
  assignedToUserId String?
  taskType         String          @default("ADDRESS_VERIFICATION")
  status           String          @default("PENDING_ASSIGNMENT")
  workerName       String
  addressText      String
  instructions     String?
  dueAt            DateTime?
  outcome          String?
  notes            String?
  rejectionReason  String?
  arrivedAt        DateTime?
  arriveLatitude   Float?
  arriveLongitude  Float?
  acceptedAt       DateTime?
  submittedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  application      Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  verification     Verification    @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  assignedTo       PortalUser?     @relation("AgentTasks", fields: [assignedToUserId], references: [id])
  evidence         FieldEvidence[]

  @@index([assignedToUserId, status])
  @@index([tenantId, clientId, status])
  @@index([status, dueAt])
}

// Photo / signature evidence captured on a field visit, stored privately in S3.
model FieldEvidence {
  id                String    @id
  fieldTaskId       String
  tenantId          String
  clientId          String
  kind              String
  status            String    @default("PENDING_UPLOAD")
  bucket            String
  objectKey         String
  originalFileName  String
  contentType       String
  declaredSizeBytes Int
  sizeBytes         Int?
  capturedLatitude  Float?
  capturedLongitude Float?
  capturedAt        DateTime?
  uploadedAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  fieldTask         FieldTask @relation(fields: [fieldTaskId], references: [id], onDelete: Cascade)

  @@unique([bucket, objectKey])
  @@index([fieldTaskId, createdAt])
}
