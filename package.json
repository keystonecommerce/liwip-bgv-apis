{
  "name": "gig-verification-v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:api": "tsx watch apps/verification-api/src/main.ts",
    "start:api": "tsx apps/verification-api/src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/apps/verification-api/src/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "client:provision": "tsx scripts/provision-client.ts",
    "key:rotate": "tsx scripts/rotate-key.ts",
    "key:revoke": "tsx scripts/revoke-key.ts",
    "key:list": "tsx scripts/list-keys.ts",
    "reviewer:provision": "tsx scripts/provision-reviewer.ts",
    "smoke": "tsx smoke-tests/run-smoke.ts",
    "smoke:documents": "tsx smoke-tests/run-document-storage-smoke.ts",
    "smoke:s3-upload": "tsx smoke-tests/run-s3-upload-smoke.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "npm run build && node --test dist/tests/unit/*.test.js",
    "test:e2e": "npm run build && node --test --test-concurrency=1 dist/tests/e2e/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/s3-request-presigner": "^3.1118.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/client": "6.12.0",
    "@simplewebauthn/server": "^14.0.3",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.1",
    "prisma": "6.12.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
