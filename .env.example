PORT=4310
CORS_ORIGINS=http://localhost:3000
SUREPASS_BASE_URL=https://sandbox.surepass.app
VERIFICATION_PROVIDER=surepass
SUREPASS_TIMEOUT_MS=30000
SUREPASS_BEARER_TOKEN=replace-with-sandbox-bearer-token
SUREPASS_CUSTOMER_ID=
SUREPASS_EAADHAAR_FILE_FIELD=file
# Production: SUREPASS_BASE_URL=https://kyc-api.surepass.app with the production token, and
# SUREPASS_ENABLED_PRODUCTS set to the products enabled on that account (see docs/SUREPASS-BGV-INTEGRATION.md).
SUREPASS_ENABLED_PRODUCTS=
DIGILOCKER_REDIRECT_URL=http://localhost:4311/?digilocker=return
DIGILOCKER_WEBHOOK_URL=
DIGILOCKER_LOGO_URL=
AADHAAR_OVSE_REDIRECT_URL=http://localhost:4311/?aadhaar=return
AADHAAR_OVSE_WEBHOOK_URL=
DATABASE_URL=postgresql://gig_verification:local-development-password@localhost:5440/gig_verification?schema=public
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_TLS=false
MSG91_SMS_ENDPOINT=https://control.msg91.com/api/v5/flow/
MSG91_AUTHKEY=replace-with-msg91-auth-key
MSG91_OTP_TEMPLATE_ID=replace-with-approved-msg91-otp-template-id
MSG91_SENDER_ID=replace-with-approved-msg91-sender-id
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
# Demo staff created by the seed (email-code sign-in): partner admin, Keystone ops, field agent.
DEV_CORPORATE_ADMIN_EMAIL=company.admin@example.test
DEV_LIWIP_SUPPORT_EMAIL=support@liwip.example.test
DEV_FIELD_AGENT_EMAIL=field.agent@example.test
MSG91_OTP_EXPIRY_MINUTES=5
MSG91_OTP_RESEND_AFTER_SECONDS=60
MSG91_OTP_MAX_SENDS_PER_HOUR=5
MSG91_OTP_MAX_VERIFY_ATTEMPTS=5
AWS_PROFILE=liwip-bgv-dev
AWS_REGION=ap-south-1
S3_DOCUMENT_BUCKET=replace-with-private-document-bucket
S3_DOCUMENT_KMS_KEY_ARN=replace-with-customer-managed-kms-key-arn
S3_PRESIGNED_URL_EXPIRY_SECONDS=300
S3_TEMP_DOCUMENT_RETENTION_DAYS=30
S3_MAX_DOCUMENT_SIZE_BYTES=15728640
# Reads PAN, licence and RC numbers from signed DigiLocker PDFs. Defaults keep text in India.
BEDROCK_REGION=ap-south-1
BEDROCK_EXTRACT_MODEL=in.anthropic.claude-haiku-4-5-20251001-v1:0
DEV_PLATFORM_API_KEY=replace-with-a-long-random-development-api-key
DEV_SECOND_PLATFORM_API_KEY=replace-with-a-different-long-random-api-key
ENABLE_INTERNAL_ROUTES=true

# --- Support tools ---
# Test environments only: allows POST /v1/admin/support/purge (deletes every person's data).
ADMIN_PURGE_ENABLED=false

# --- Global rate limit (per client IP) ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120


# Authenticated partner quota, shared across keys and replicas (requests/minute).
PARTNER_RATE_LIMIT=120
# Default is zero. Set the exact hop count only behind a trusted reverse proxy.
TRUST_PROXY_HOPS=0

# Quick sign-in (WebAuthn passkeys): the site's domain and its exact origins.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:4311
WEBAUTHN_RP_NAME=Liwip
# Signs worker tokens (OTP and passkey sign-in). 32+ characters.
WORKER_TOKEN_SECRET=
WORKER_AADHAAR_RETURN_URL=http://localhost:4311/?identity=aadhaar

# --- Admin panel (/v1/admin/*): staff sessions, email OTP, passkeys. See docs/ADMIN-ACCESS.md ---
# Signs CSRF tokens and hashes sign-in codes and IPs. 32+ random characters.
ADMIN_AUTH_SECRET=
# Exact origins of both admin apps (control and business). Added to the CORS allowlist (credentials) and
# required for passkeys and for Origin checks on state-changing requests.
ADMIN_PANEL_ORIGINS=http://localhost:4312,http://localhost:4313
# The two apps in liwip-bgv-admin. Invites and Cashfree returns link to the right one:
# Keystone staff to the control panel, partners, vendors and verifiers to the business portal.
ADMIN_CONTROL_URL=http://localhost:4312
ADMIN_BUSINESS_URL=http://localhost:4313
# Fallback for both when the two above are unset.
ADMIN_PANEL_URL=http://localhost:4312
# Passkey relying party: defaults to the panel's hostname; set a parent domain (liwip.com) to share passkeys across subdomains.
ADMIN_WEBAUTHN_RP_ID=
# Session cookie: Secure, httpOnly, SameSite=Lax, __Host- prefixed. Only local http dev may set false.
ADMIN_COOKIE_SECURE=false
ADMIN_SESSION_TTL_HOURS=12
# Powerful actions (refunds, prices, roles, API keys) need a sign-in, confirmation or another
# powerful action this recent. Sliding: each powerful action restarts it.
ADMIN_RECENT_SIGN_IN_MINUTES=60
# First platform admin, created by `npm run db:seed` (or `npm run admin:provision -- email`).
ADMIN_BOOTSTRAP_EMAIL=
# Staff email (MSG91 Email). Unset outside production: emails, including sign-in codes, are printed to the API log.
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_FROM=
MSG91_EMAIL_OTP_TEMPLATE_ID=
MSG91_EMAIL_INVITE_TEMPLATE_ID=

# --- Payments (Cashfree PG) and seats. See docs/PRICING-AND-PAYMENTS.md ---
# sandbox | production. Keys come from the Cashfree dashboard; never commit them.
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2025-01-01
# Public URL Cashfree calls for payment notices: https://<api host>/v1/payments/cashfree/webhook
CASHFREE_NOTIFY_URL=
# GST in basis points (1800 = 18%). Seller defaults to Keystone Commerce Private Limited,
# GSTIN 29AAMCK2232K1Z9 (Karnataka); SAC defaults to 998521 (to confirm with the CA).
BILLING_GST_BPS=1800
BILLING_SELLER_NAME=
BILLING_SELLER_GSTIN=
BILLING_SELLER_ADDRESS=
BILLING_SELLER_STATE=
BILLING_SAC_CODE=
# Where Cashfree returns a partner after paying ({order_id} is replaced). Default: ADMIN_PANEL_URL/billing/orders/{order_id}
BILLING_PARTNER_RETURN_URL=
# off: no order reconciliation, invite expiry, usage rating or statement timers (tests).
BILLING_JOBS=
# Partners' API checks are billed per check from this instant (ISO). Unset: usage is not billed.
BILLING_USAGE_START=
BILLING_STATEMENT_DUE_DAYS=15
# The Liwip app (individual checkout return, invite landing) and the short-link host for invites.
WORKER_APP_URL=http://localhost:4311
# Development only, until the worker pay flow is built: "allow" lets chosen checks run without a bundle.
# Ignored when NODE_ENV=production.
WORKER_UNPAID_CHECKS=
# Days a new field visit has before it is overdue.
FIELD_TASK_DUE_DAYS=3
INVITE_LINK_BASE=http://localhost:4310
INVITE_VALID_DAYS=30
# Invite links by WhatsApp through AiSensy, as the main backend sends (aisensy). log: the link is
# only written to the API log (staging, until the template is approved). Unset: logged, refused in production. The campaign's template: {{1}} name, {{2}} company, URL button INVITE_LINK_BASE/v/{{1}}.
INVITE_SENDER=
AISENSY_API_KEY=
AISENSY_INVITE_CAMPAIGN_NAME=
AISENSY_ENDPOINT=https://backend.aisensy.com/campaign/t1/api/v2
AISENSY_SOURCE=Liwip_BGV_Invites

# Egress IPs of servers that relay their users' requests (the worker web app), comma-separated.
# Their requests are throttled per relayed person (X-End-User-IP) instead of sharing one bucket.
TRUSTED_RELAY_IPS=
