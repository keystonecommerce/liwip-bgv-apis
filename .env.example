PORT=3001
UI_PORT=3002
SUREPASS_BASE_URL=https://sandbox.surepass.app
SUREPASS_BEARER_TOKEN=replace-with-sandbox-bearer-token
SUREPASS_CUSTOMER_ID=
SUREPASS_EAADHAAR_FILE_FIELD=file
DIGILOCKER_REDIRECT_URL=http://localhost:3100/?digilocker=return
DIGILOCKER_WEBHOOK_URL=
DIGILOCKER_LOGO_URL=
AADHAAR_OVSE_REDIRECT_URL=http://localhost:3100/?aadhaar=return
AADHAAR_OVSE_WEBHOOK_URL=
DATABASE_URL=postgresql://gig_verification:local-development-password@localhost:5440/gig_verification?schema=public
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
MSG91_SMS_ENDPOINT=https://control.msg91.com/api/v5/flow/
MSG91_AUTHKEY=replace-with-msg91-auth-key
MSG91_OTP_TEMPLATE_ID=replace-with-approved-msg91-otp-template-id
MSG91_SENDER_ID=replace-with-approved-msg91-sender-id
OTP_HASH_SECRET=replace-with-at-least-32-random-characters
PORTAL_AUTH_TOKEN_SECRET=replace-with-a-different-at-least-32-random-character-secret
PORTAL_AUTH_TOKEN_EXPIRY_SECONDS=28800
DEV_CORPORATE_ADMIN_EMAIL=company.admin@example.test
DEV_CORPORATE_ADMIN_PASSWORD=replace-with-a-development-only-password
DEV_LIWIP_SUPPORT_EMAIL=support@liwip.example.test
DEV_LIWIP_SUPPORT_PASSWORD=replace-with-a-development-only-password
DEV_FIELD_AGENT_EMAIL=field.agent@example.test
DEV_FIELD_AGENT_PASSWORD=replace-with-a-development-only-password
MSG91_OTP_EXPIRY_MINUTES=5
MSG91_OTP_RESEND_AFTER_SECONDS=60
MSG91_OTP_MAX_SENDS_PER_HOUR=5
MSG91_OTP_MAX_VERIFY_ATTEMPTS=5
AWS_PROFILE=liwip-bgv-dev
AWS_REGION=ap-south-1
S3_DOCUMENT_BUCKET=replace-with-private-document-bucket
S3_DOCUMENT_KMS_KEY_ARN=replace-with-customer-managed-kms-key-arn
S3_PRESIGNED_URL_EXPIRY_SECONDS=300
S3_TEMP_DOCUMENT_RETENTION_DAYS=30
S3_MAX_DOCUMENT_SIZE_BYTES=15728640
DEV_PLATFORM_API_KEY=replace-with-a-long-random-development-api-key
DEV_SECOND_PLATFORM_API_KEY=replace-with-a-different-long-random-api-key
ENABLE_INTERNAL_ROUTES=true

# --- Admin provisioning API (operator-only /admin routes) ---
# REQUIRED for the /admin surface; if unset, /admin fails closed (503).
ADMIN_API_KEY=

# --- Global rate limit (per client IP) ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
